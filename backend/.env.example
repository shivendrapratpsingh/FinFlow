# FinFlow Backend — Environment Variables Template
# Copy this to .env and fill in the values

APP_NAME=FinFlow
APP_ENV=production
APP_VERSION=1.0.0
DEBUG=false

# Database — paste your Neon PostgreSQL connection string here
# Get it from: console.neon.tech → your project → Connection Details → select "asyncpg"
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?ssl=require

# Security — generate a strong random string (e.g. openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — add your Vercel frontend URL here
ALLOWED_ORIGINS=["https://YOUR-APP.vercel.app","http://localhost:3000"]

# AI (optional — add your OpenAI key for the AI assistant to work)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Leave these blank for now (features will gracefully degrade)
REDIS_URL=
CHROMA_HOST=localhost
CHROMA_PORT=8008
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_VISION_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@finflow.app
SENTRY_DSN=
LOG_LEVEL=INFO
