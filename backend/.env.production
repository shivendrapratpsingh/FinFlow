# FinFlow — Production Environment Variables
# Copy this to .env on your server, or paste into Render dashboard

APP_NAME=FinFlow
APP_ENV=production
APP_VERSION=1.0.0

# ── DATABASE (get from Neon.tech — free PostgreSQL) ──────────────────
# Go to https://console.neon.tech → New Project → Connection String
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?ssl=require

# ── SECURITY (generate with: python -c "import secrets; print(secrets.token_hex(32))") ──
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS (your Vercel frontend URL) ──────────────────────────────────
ALLOWED_ORIGINS=https://your-app-name.vercel.app,http://localhost:3000

# ── AI ASSISTANT (optional — get from platform.openai.com) ──────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── EMAIL (optional — Gmail App Password) ───────────────────────────
# Enable at: Google Account → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your@gmail.com

# ── PAYMENTS (optional — get from razorpay.com, free to register) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── LEAVE BLANK (not needed for basic use) ──────────────────────────
REDIS_URL=
CELERY_BROKER_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENTRY_DSN=
LOG_LEVEL=WARNING
