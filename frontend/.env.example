# FinFlow Frontend — Environment Variables Template
# On Vercel: paste these in Project Settings → Environment Variables

# Your Railway backend URL (e.g. https://finflow-backend-production.up.railway.app)
NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.railway.app

NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
