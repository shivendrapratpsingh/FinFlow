# ============================================================
# FINFLOW — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ── APP ─────────────────────────────────────────────────────
APP_NAME=FinFlow
APP_ENV=development          # development | staging | production
APP_VERSION=1.0.0
DEBUG=true

# ── DATABASE ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://finflow:finflow_secret@localhost:5432/finflow_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ── SECURITY ────────────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── AI / OPENAI ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── VECTOR DATABASE (Chroma) ────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8008
CHROMA_COLLECTION=finflow_knowledge

# ── OCR ─────────────────────────────────────────────────────
GOOGLE_VISION_API_KEY=your-google-vision-api-key
OCR_PROVIDER=google_vision    # google_vision | tesseract | azure

# ── PAYMENT GATEWAYS ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── EMAIL ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@finflow.app

# ── SMS (Twilio) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ── WHATSAPP (Meta Business API) ────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ── GOOGLE OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── STORAGE (AWS S3 / compatible) ───────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=finflow-documents
S3_ENDPOINT_URL=                # Leave empty for AWS, set for MinIO/R2

# ── CELERY ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── GST API ─────────────────────────────────────────────────
GST_API_KEY=your-gst-api-key
GST_API_BASE_URL=https://api.gst.gov.in

# ── MONITORING ──────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
LOG_LEVEL=INFO
